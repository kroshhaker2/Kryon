From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: krosh <krosh@kroshhaker.dev>
Date: Fri, 27 Nov 2026 22:33:51 +0300
Subject: [PATCH] Kryon - rewrite world generation


diff --git a/net/minecraft/server/level/ServerLevel.java b/net/minecraft/server/level/ServerLevel.java
index 78a90480c02a09c63b745c3dd0c9159509532193..11f6f6f663a4a91cf2bcbd9df8bd884d9b1acf84 100644
--- a/net/minecraft/server/level/ServerLevel.java
+++ b/net/minecraft/server/level/ServerLevel.java
@@ -224,6 +224,9 @@ public class ServerLevel extends Level implements WorldGenLevel, ServerEntityGet
     private final boolean tickTime;
     private final LevelDebugSynchronizers debugSynchronizers = new LevelDebugSynchronizers(this);
 
+    // Kryon - rewrite worldgen
+    private java.lang.foreign.MemorySegment kryonGenerator = java.lang.foreign.MemorySegment.NULL;
+
     // CraftBukkit start
     private final ResourceKey<LevelStem> typeKey;
     public final String bukkitName;
@@ -671,9 +674,25 @@ public class ServerLevel extends Level implements WorldGenLevel, ServerEntityGet
             }
         }
 
-        if (gen != null) {
+        // Kryon start - rewrite worldgen
+        if (gen == null) {
+            var dimensionType = levelStem.type().value();
+
+            this.kryonGenerator = io.papermc.paper.kryon.KryonNative.createGenerator(
+                worldGenSettings.options().seed(),
+                dimensionType,
+                server.registryAccess()
+            );
+
+            generator = new io.papermc.paper.kryon.KryonChunkGenerator(
+                generator.getBiomeSource(),
+                this.kryonGenerator,
+                dimensionType
+            );
+        } else {
             generator = new org.bukkit.craftbukkit.generator.CustomChunkGenerator(this, generator, gen);
         }
+        // Kryon end - rewrite worldgen
         // CraftBukkit end
         boolean syncWrites = server.forceSynchronousWrites();
         DataFixer fixerUpper = server.getFixerUpper();
@@ -2931,7 +2950,15 @@ public class ServerLevel extends Level implements WorldGenLevel, ServerEntityGet
 
     @Override
     public void close() throws IOException {
-        super.close();
+        // Kryon - rewrite worldgen
+        try {
+            super.close();
+        } finally {
+            if (this.kryonGenerator.address() != 0) {
+                io.papermc.paper.kryon.KryonNative.destroyGenerator(this.kryonGenerator);
+                this.kryonGenerator = java.lang.foreign.MemorySegment.NULL;
+            }
+        }
         //this.entityManager.close(); // Paper - rewrite chunk system
     }
